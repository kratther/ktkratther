<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Invite</title>

<style>
body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  overflow: hidden;
}

/* Background Gradient */
#app {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0f172a, #1e293b, #111827);
  color: white;
  position: relative;
}

/* Card */
.card {
  text-align: center;
  max-width: 380px;
  padding: 30px;
  border-radius: 20px;
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
}

/* Title */
.title {
  font-size: 40px;
  font-weight: bold;
  margin-bottom: 10px;
}

/* Name */
.name {
  font-size: 28px;
  color: gold;
}

/* Message */
.message {
  margin-top: 15px;
  font-size: 16px;
  opacity: 0.9;
}

/* Tagline (ตัวสำคัญ) */
.tagline {
  margin-top: 30px;
  font-size: 13px;
  letter-spacing: 2px;
  color: #facc15;
  opacity: 0.8;
}

/* Button */
button {
  margin-top: 20px;
  padding: 10px 20px;
  border: none;
  border-radius: 20px;
  background: gold;
  color: black;
  cursor: pointer;
}

/* Confetti */
.confetti {
  position: absolute;
  width: 8px;
  height: 8px;
  background: red;
  top: -10px;
  animation: fall linear forwards;
}

@keyframes fall {
  to {
    transform: translateY(100vh) rotate(360deg);
    opacity: 0;
  }
}
</style>
</head>

<body>

<div id="app">
  <div class="card">

    <div class="title">Birthday Party 🎉</div>
    <div class="name">เพื่อนสนิทของฉัน</div>

    <div class="message">
      วันเกิดปีนี้ อยากให้มีแต่คนที่ “ใช่” อยู่ด้วยกัน<br>
      มานั่งชิล กิน ดื่ม และหัวเราะไปด้วยกัน
    </div>

    <div class="message">
      📍 โฟล์คพระนคร รัชดา กรุงเทพฯ<br>
      📅 8 เมษายน 2569
    </div>

    <button onclick="celebrate()">Celebrate</button>

    <div class="tagline">
      Only good vibes & real friends
    </div>

  </div>
</div>

<script>
function celebrate() {
  for (let i = 0; i < 40; i++) {
    let confetti = document.createElement("div");
    confetti.className = "confetti";
    confetti.style.left = Math.random() * 100 + "vw";
    confetti.style.background = ["gold","white","pink"][Math.floor(Math.random()*3)];
    confetti.style.animationDuration = (Math.random()*2+2) + "s";
    document.body.appendChild(confetti);

    setTimeout(() => confetti.remove(), 4000);
  }
}
</script>

</body>
</html>